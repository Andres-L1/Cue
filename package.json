{
  "name": "chedex-launcher",
  "version": "1.3.3",
  "description": "Launcher de herramientas para creadores de contenido",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "Chedex Launcher",
  "author": "Chedex",
  "build": {
    "appId": "app.chedex.launcher",
    "productName": "Chedex Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Chedex-Launcher-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Chedex-Launcher-Mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Chedex <hola@chedex.app>",
      "artifactName": "Chedex-Launcher-Linux.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Andres-L1",
        "repo": "Cue"
      }
    ]
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "electron-updater": "^6.8.11"
  }
}
